{
  "name": "certiverify-server",
  "version": "1.0.0",
  "description": "Backend API for CertiVerify certificate issuance and verification platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
